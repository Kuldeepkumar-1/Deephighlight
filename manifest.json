{
  "manifest_version": 3,
  "name": "DeepHighlight",
  "version": "1.0.0",
  "description": "Non-destructive crosshair, row, and column highlighting for Google Sheets.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://docs.google.com/spreadsheets/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://docs.google.com/spreadsheets/*"],
      "css": ["style.css"],
      "js": [
        "storage.js",
        "observer.js",
        "overlay.js",
        "highlight.js",
        "toolbar.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_page": "options.html",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}